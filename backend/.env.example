# ─────────────────────────────────────────────────────────────────────────────
# Clara — backend configuration. Copy to `backend/.env` and fill in your key.
# Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider: mistral | ollama ───────────────────────────────────────────
# Free fully-local option: set LLM_PROVIDER=ollama AND EMBED_PROVIDER=ollama
# (then: ollama pull mistral-nemo && ollama pull nomic-embed-text). Nothing
# leaves the machine — ideal for RGPD-sensitive data.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
# Reliable model for ingestion extraction + French formatting:
MISTRAL_MODEL=mistral-medium-latest
# Small/fast model for the router/Manager (used in step 3):
MISTRAL_ROUTER_MODEL=mistral-small-latest

# ── Embeddings provider: mistral | ollama ────────────────────────────────────
EMBED_PROVIDER=mistral
MISTRAL_EMBED_MODEL=mistral-embed
# Used if LLM_PROVIDER=ollama and/or EMBED_PROVIDER=ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Vector store (ChromaDB, local) ───────────────────────────────────────────
# CHROMA_DIR=../base_clara
CHROMA_COLLECTION=clara_docs

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── PII guardrail (Presidio, French) ─────────────────────────────────────────
PII_LANGUAGE=fr
SPACY_MODEL=fr_core_news_md
# Keep the raw uploaded file after ingestion? It still contains PII.
# false (default) = delete it once the cleaned .md is produced (privacy-by-design).
KEEP_UPLOADS=false

# ── Back-office (auth HTTP Basic) ────────────────────────────────────────────
# Sécurise /admin et les API documents/logs. ADMIN_PASSWORD vide = back-office DÉSACTIVÉ.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── CORS (add your Zend/PHP site origin in production) ───────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500,http://localhost:8000
